<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Truvio.Commerce.Serializer</RootNamespace>
    <AssemblyName>Truvio.Commerce.Serializer</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>

    <!-- NuGet package metadata -->
    <PackageId>Truvio.Commerce.Serializer</PackageId>
    <!-- Prerelease suffix renders as the BETA flag in the DW10 admin "Available apps" list -->
    <Version>0.6.6-beta</Version>
    <AssemblyVersion>0.6.6.0</AssemblyVersion>
    <Title>Truvio Commerce Serializer</Title>
    <Description>Serialize and deserialize Truvio Commerce (Dynamicweb 10) database state to YAML files for version control and environment sync.</Description>
    <Authors>JustDynamics</Authors>
    <Company>JustDynamics</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Shown in the DW10 admin "Available apps" list: NuGetAddinProvider maps the package's
         IconUrl (served by nuget.org from this embedded icon) onto AddinInfo.Image. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/justdynamics/Truvio.Commerce.Serializer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/justdynamics/Truvio.Commerce.Serializer</RepositoryUrl>
    <!-- "dynamicweb-app-store" + "Addin" + "dw10" are required by the DW10 admin app-store
         search (NuGetAddinProvider DEFAULT_SEARCH_TERM); "commerce" and "integration" map to
         the Categories column via GetCategoriesFromTags. -->
    <PackageTags>dynamicweb-app-store Addin dw10 commerce integration truvio-commerce dynamicweb serializer</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**/*" />
    <!-- The Swift starter is also embedded so the settings screen's "Get started" action can
         apply it (with a chosen areaId) without any file having to exist on disk first. -->
    <EmbeddedResource Include="Configuration\swift-starter.json" />
    <!-- Ship the Swift starter into the host's Files/System/Serializer/ on app-store install.
         DW10's NuGetAddinProvider extracts ONLY the package's top-level Files\ folder into the
         live archive (archive.GetFiles("Files") -> SystemInformation.MapPath("/Files"), leading
         "Files/" stripped) — content\ items land in the addin folder, NOT in /Files. The
         content\ copy stays for legacy/manual installs (doc.dynamicweb.com forum:
         locally-installing-nuget-package). The .example suffix keeps ConfigPathResolver from
         ever picking it up as the live config — users copy/rename it (or upload their own,
         or use the settings screen's Get-started action) to activate it. -->
    <Content Update="Configuration\swift-starter.json" Pack="true"
             PackagePath="Files\System\Serializer\swift-starter.example.json;content\Files\System\Serializer\swift-starter.example.json" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 37-06: ConfigLoader._testDefaultValidatorConstructedCallback is marked internal
         (T-37-06-03 threat model: production code in other assemblies cannot subscribe). The
         test assembly needs access to the field to prove the default-validator construction
         path executes — exactly the structural-integration surface the field exists for. -->
    <InternalsVisibleTo Include="Truvio.Commerce.Serializer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dynamicweb" Version="10.23.9" />
    <PackageReference Include="Dynamicweb.Content.UI" Version="10.23.9" />
    <PackageReference Include="Dynamicweb.CoreUI.Rendering" Version="10.23.9" />
    <!-- Payment/shipping method edit screens (PaymentEditScreen / ShippingEditScreen) for
         the deploy/seed mode alerts on SqlTable-managed commerce methods. -->
    <PackageReference Include="Dynamicweb.Ecommerce.UI" Version="10.23.9" />
    <PackageReference Include="Dynamicweb.Files.UI" Version="10.23.9" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.15" />
  </ItemGroup>

</Project>
